{
  // Cloudflare Worker: serves the page (public/index.html), relays two read-only Kalshi requests, and
  // (with KALSHI_KEY_ID and KALSHI_PRIVATE_KEY set as secrets) streams Kalshi's BRTI index and the
  // market's prices to the page through one Durable Object. GitHub Pages serves the identical copy
  // at the repo root.
  "name": "btc15-tape",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "FEED", "class_name": "KalshiFeed" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KalshiFeed"] }],
  "observability": { "enabled": true }
}
